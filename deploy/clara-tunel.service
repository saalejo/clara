# El túnel de Cloudflare que expone las dos superficies a internet:
#   clara.voz-digital.com   -> localhost:7860  (interfaz de llamada)
#   panel.voz-digital.com -> localhost:8081  (consola de administración)
#
# Es un túnel con nombre gestionado localmente: las credenciales viven en
# ~/.cloudflared/ (cert.pem + <id>.json, fuera del repositorio) y el ingress
# en ~/.cloudflared/config.yml.
#
# Creación (una vez, requiere `cloudflared tunnel login`):
#   cloudflared tunnel create clara
#   cloudflared tunnel route dns clara clara.voz-digital.com
#   cloudflared tunnel route dns clara panel.voz-digital.com
#   (el ingress va en ~/.cloudflared/config.yml)
#
# `tunnel run` va SIN nombre a propósito: el túnel lo elige la clave `tunnel:`
# de ~/.cloudflared/config.yml, que lleva el UUID. Así la unidad no depende del
# nombre —que se puede cambiar en el panel de Cloudflare sin tocar el DNS— y
# cambiar de túnel es editar una línea del config, no reinstalar la unidad.
#
# Instalación:
#   cp deploy/clara-tunel.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now clara-tunel
[Unit]
Description=Tunel de Cloudflare hacia la interfaz de llamada y la consola
After=network-online.target

[Service]
Type=exec
ExecStart=%h/.local/bin/cloudflared tunnel run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
