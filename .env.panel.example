# Configuración del panel de control. Es un fichero APARTE del .env del agente,
# y eso es deliberado: el contenedor del panel no monta el del agente, así que
# no puede filtrar las claves de OpenRouter ni de Deepgram ni por accidente.
#
#   cp .env.panel.example .env.panel && chmod 600 .env.panel

# Obligatoria. Genérala con:
#   python -c 'import secrets; print(secrets.token_urlsafe(50))'
PANEL_SECRET_KEY=

# Usuario administrador. Se crea o se actualiza en cada arranque, así que
# cambiar la contraseña es editar aquí y reiniciar.
PANEL_ADMIN_USER=ember
PANEL_ADMIN_PASSWORD=

# Dónde escucha. Esto solo aplica a `make panel` (ejecución nativa): dentro
# del contenedor, la unidad Quadlet fuerza PANEL_HOST=0.0.0.0 después de leer
# este fichero, porque si no uvicorn escucharía en el loopback *del
# contenedor* y el puerto publicado no contestaría. Quien restringe el acceso
# es PublishPort=127.0.0.1:8080 en la unidad.
# Se llega con: ssh -L 8080:localhost:8080 nanopi
PANEL_HOST=127.0.0.1
PANEL_PORT=8080

# Exponerlo a la red local es una decisión consciente: quien entre en el panel
# puede ejecutar comandos en la placa. Déjalo en 0 salvo que sepas lo que haces,
# y si lo pones a 1 añade el origen a PANEL_CSRF_TRUSTED_ORIGINS.
PANEL_PERMITIR_LAN=0
# PANEL_CSRF_TRUSTED_ORIGINS=http://192.168.1.160:8080

# Interruptor general de los hooks que ejecutan comandos. A 0 no se pueden crear
# desde el panel.
PANEL_HOOKS_COMANDO=1

# Unidades de systemd que el panel puede gobernar. La lista es corta a
# propósito: el socket de D-Bus da poder sobre todos los servicios del usuario.
PANEL_UNIDAD_AGENTE=voice-agent.service
PANEL_UNIDAD_INGESTA=voice-agent-ingest.service

# --- Detrás del túnel de Cloudflare ------------------------------------------
# Enciende las galletas seguras y hace que Django lea X-Forwarded-Proto (a
# uvicorn la petición le llega como http sobre loopback). En local se queda en
# 0: una galleta `Secure` sobre http se descarta en silencio y el login se
# queda en un bucle sin un solo mensaje de error.
#
# Los dos van JUNTOS. Con TRAS_TLS=1 y sin orígenes de confianza, Django activa
# la comprobación estricta de Origin en cada POST y todo el panel responde 403
# mientras los GET siguen perfectos. Por eso el arranque falla si falta.
PANEL_TRAS_TLS=0
# PANEL_CSRF_TRUSTED_ORIGINS=https://panel.voz-digital.com
