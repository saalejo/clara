# Entorno del puente de telefonía (opcional).
#
# El puente funciona sin este fichero; la unidad lo carga con `-` delante para
# que su ausencia no sea un error. Sirve para los casos raros.
#
#     cp .env.telefonia.example .env.telefonia
#
# Ojo: este fichero es del PUENTE, no del agente. Sus ajustes equivalentes de
# `Settings` (TELEFONIA_*) los lee el agente desde su propio .env.

# MAC del móvil, si hay más de uno emparejado y quieres fijar cuál.
# TELEFONIA_BLUETOOTH_ADDRESS=AA:BB:CC:DD:EE:FF

# Cada cuánto se vuelve a bajar la agenda por PBAP.
# TELEFONIA_CONTACTOS_TTL_HORAS=12

# DEBUG enseña el detalle de las conversaciones con D-Bus y con obexd.
# LOG_LEVEL=INFO
