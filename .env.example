# Configuración del agente de voz. Copia este fichero a `.env` y rellénalo:
#
#     cp .env.example .env
#
# Todas las variables tienen un valor por defecto razonable salvo
# GEMINI_API_KEY (o GROQ_API_KEY con LLM_BACKEND=groq), que es obligatoria. La
# definición canónica de cada opción (tipo, validación y motivo) está en
# packages/core/src/voice_agent_core/config.py.

# =============================================================================
# LLM — restringido por el reto (compuerta G3): Gemini Flash o Llama vía Groq,
# ambos en su nivel gratuito. Usar un modelo fuera de la lista descalifica.
# =============================================================================

# Proveedor: `gemini` (por defecto) o `groq`. Groq es el plan B para la demo:
# el nivel gratuito de Gemini ronda las 10 peticiones/minuto y una conversación
# animada con RAG lo roza; el de Groq es más holgado.
LLM_BACKEND=gemini

# Clave gratuita de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo de la gama Gemini Flash (la familia permitida). En un agente de voz
# manda la latencia del primer token, no el "cociente intelectual" del modelo.
#   gemini-2.5-flash        equilibrio recomendado
#   gemini-2.5-flash-lite   más rápido y con límites gratuitos más holgados
GEMINI_MODEL=gemini-2.5-flash

# Solo si LLM_BACKEND=groq. Clave gratuita: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

LLM_TEMPERATURE=0.6

# Tope de tokens por respuesta. Bajo a propósito: nadie quiere escuchar tres
# párrafos sintetizados.
LLM_MAX_TOKENS=400

# =============================================================================
# STT — transcripción de voz a texto
# =============================================================================

# Motor de reconocimiento de voz. La diferencia entre los dos no es sutil;
# medido en esta placa con las mismas frases (ver docs/rendimiento.md):
#
#                    frases perfectas   error por palabra   latencia
#   whisper (tiny)        3 de 7             33.1 %          3.60 s
#   deepgram (nova-3)     7 de 7              0.0 %          0.61 s
#
# whisper  = local. Sin coste, sin dependencia de red, privado. A cambio, las
#            preguntas cortas le salen mal y se lleva más de la mitad de la
#            latencia total.
# deepgram = en la nube, en streaming. Transcribe mientras hablas. Requiere
#            DEEPGRAM_API_KEY y tiene coste por minuto.
STT_BACKEND=whisper

# tiny | base | small | medium. Tienen que ser multilingües: los modelos
# terminados en `.en` son solo inglés y la configuración los rechaza.
# Medido en esta placa: tiny ~3.0 s por intervención, base ~5.5 s. Y en las
# pruebas 'tiny' además transcribió mejor. Ver docs/rendimiento.md.
WHISPER_MODEL=tiny

# int8 es la única cuantización sensata en ARM sin GPU.
WHISPER_COMPUTE_TYPE=int8

# Hilos de inferencia. Medido: 1->5.2 s, 2->3.2 s, 4->3.0 s, 6->2.7 s.
# Se usan 4 para dejar dos núcleos al audio en tiempo real.
WHISPER_CPU_THREADS=4

# Anchura del haz de búsqueda. 1 (voraz) es ~12 % más rápido que el 5 por
# defecto de faster-whisper y no perdió precisión en las pruebas.
WHISPER_BEAM_SIZE=1

# Solo si STT_BACKEND=deepgram. Se obtiene en https://console.deepgram.com
#DEEPGRAM_API_KEY=

# nova-3 es el más reciente y el que mejor rinde en español; nova-2 es la
# generación anterior.
DEEPGRAM_MODEL=nova-3

# Latencia P99 de Deepgram desde el fin del habla hasta el transcript final.
# Pipecat trae 0.35 s, pero ese valor asume VAD_STOP_SECS=0.2; con un stop_secs
# mayor la red de seguridad del fin de turno se colapsa y avisa en cada frase.
# 0.9 s sale de medir la ida y vuelta real desde esta placa (0.61 s de media).
DEEPGRAM_TTFS_P99=0.9

# =============================================================================
# TTS — síntesis de voz (Piper, local)
# =============================================================================

# es_ES-davefx-medium    España, equilibrado (recomendado en esta placa)
# es_ES-sharvard-medium  España, dos locutores
# es_MX-claude-high      México, más natural pero bastante más CPU
# es_AR-daniela-high     Argentina, más natural pero bastante más CPU
TTS_VOICE=es_ES-davefx-medium

# =============================================================================
# Audio
# =============================================================================

# headset = auriculares. El micro no oye al altavoz, así que puedes interrumpir
#           al agente hablando encima (barge-in).
# speaker = altavoz y micro abiertos. El agente se interrumpiría a sí mismo, así
#           que se trabaja en semidúplex: mientras habla, ignora la entrada.
AUDIO_PROFILE=headset

# Nombre (o subcadena) del dispositivo de PortAudio. Déjalo en "default" para
# usar la capa ALSA `plug` de deploy/asound.conf, que es lo que permite trabajar
# a 16 kHz mono sobre una tarjeta que solo soporta 44.1/48 kHz.
# Lista los dispositivos disponibles con:  make audio-check
AUDIO_INPUT_DEVICE=default
AUDIO_OUTPUT_DEVICE=default

# 16000 u 8000. Silero VAD no admite otra cosa.
AUDIO_SAMPLE_RATE=16000

# Ajuste fino del VAD. Si se dejan vacías, se derivan de AUDIO_PROFILE:
# headset usa 0.7 / 0.2 / 0.2 y speaker 0.85 / 0.35 / 0.6.
# Ojo con VAD_STOP_SECS: Pipecat calibra las latencias P99 de sus servicios de
# STT suponiendo 0.2, y subirlo obliga a declarar el P99 a mano.
#VAD_CONFIDENCE=0.7
#VAD_START_SECS=0.2
#VAD_STOP_SECS=0.2

# Silencio tras el que se da por cerrado el turno del usuario. Súbelo si el
# agente te corta mientras piensas.
USER_SPEECH_TIMEOUT=0.6

# =============================================================================
# Muletillas — respuestas pregrabadas que tapan los silencios de espera
# =============================================================================

# Un "déjame consultarlo" dicho al instante no acelera nada, pero evita el
# silencio que hace dudar de si el agente te ha oído. Se sintetizan una vez y se
# cachean en data/fillers; reproducirlas después es instantáneo.
FILLER_ENABLED=true

# Silencio que se tolera antes de soltar una muletilla genérica. Medido en esta
# placa: el modelo suelta su primer token hacia el segundo, y cuando decide
# consultar el RAG la llamada aparece hacia los 1.2 s. Con un umbral menor la
# muletilla genérica ("a ver...") se adelantaba a la de consulta ("déjame
# consultarlo"), que es más informativa, y encima la bloqueaba.
FILLER_DELAY_SECS=1.2

# Intervalo mínimo entre dos muletillas seguidas.
FILLER_MIN_GAP_SECS=4.0

# Las frases se editan en src/voice_agent/prompts.py (MULETILLAS).
#
# La caché se invalida sola: el nombre de cada fichero incluye un resumen del
# texto, la voz y la frecuencia. Así que al cambiar TTS_VOICE, editar una frase o
# tocar AUDIO_SAMPLE_RATE, las afectadas se resintetizan en el siguiente arranque
# (unos seis segundos más, una sola vez). Las de voces usadas antes siguen en
# disco, de modo que volver a una voz anterior es inmediato.

# =============================================================================
# RAG — ChromaDB
# =============================================================================

# DATA_DIR y CORPUS_DIR se dejan comentadas A PROPOSITO. Los valores por
# defecto del código ya son `data` y `corpus`, que es lo correcto al ejecutar
# de forma nativa; y dentro del contenedor las rutas son otras (/data y
# /corpus), que es lo que fija el Containerfile.
#
# Si las descomentas aquí, `podman run --env-file .env` las inyectará en el
# contenedor y machacará las del Containerfile: el agente buscará el índice en
# `data/chroma` relativo a /app, no lo encontrará, y además volverá a descargar
# el modelo de embeddings porque la caché también apuntará a una ruta relativa.
# El síntoma es un "La colección 'conocimiento' no existe" desconcertante,
# porque `make ingest` sí funcionó.
#DATA_DIR=data
#CORPUS_DIR=corpus

CHROMA_COLLECTION=conocimiento

# Modelo de embeddings de fastembed. Debe ser multilingüe para el español.
# Alternativa de más calidad (y más lenta): jinaai/jina-embeddings-v2-base-es
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Fragmentos a recuperar por consulta.
RAG_TOP_K=4

# Distancia coseno máxima para aceptar un fragmento. Si lo subes demasiado, el
# modelo recibe contexto irrelevante y alucina; si lo bajas demasiado, el RAG
# no encuentra nada aunque la respuesta esté en el corpus.
RAG_MAX_DISTANCE=0.68

CHUNK_SIZE=700
CHUNK_OVERLAP=120

# =============================================================================
# Varios
# =============================================================================

# DEBUG para ver el detalle de frames de Pipecat, INFO para uso normal.
LOG_LEVEL=INFO

# Zona horaria que usa la herramienta obtener_fecha_hora.
TIMEZONE=America/Bogota

# =============================================================================
# Telefonía (Bluetooth manos libres)
# =============================================================================
# Todo esto es OPCIONAL. Con el puente de telefonía parado, el agente arranca y
# se comporta exactamente igual que si esta sección no existiera.
# Puesta en marcha completa: docs/telefonia.md

# auto | on | off
#   auto  sondea el puente al arrancar y activa las herramientas si contesta.
#         Es el valor por defecto y no hay que tocar nada.
#   on    las activa aunque el puente no esté (para arrancarlo después).
#   off   no las activa nunca; el agente queda como antes de la telefonía.
# TELEFONIA_MODO=auto

# MAC del móvil emparejado. Vacío = el primero que ofrezca manos libres, que es
# lo normal cuando solo hay uno.
# TELEFONIA_BLUETOOTH_ADDRESS=

# Cada cuánto se vuelve a descargar la agenda del móvil por PBAP.
# TELEFONIA_CONTACTOS_TTL_HORAS=12

# Lo que dice el agente al entrar una llamada. Es texto fijo y no pasa por el
# modelo, a propósito: un móvil suena unos 25 segundos. Marcador: {quien}
# TELEFONIA_ANUNCIO=Te llama {quien}. ¿Respondo?

# Tope de espera de cada petición al puente. Mientras una herramienta corre, el
# agente calla, así que no puede ser generoso.
# TELEFONIA_TIMEOUT_SECS=4.0

# Cuántos contactos parecidos se le enseñan al modelo cuando hay ambigüedad.
# TELEFONIA_MAX_CANDIDATOS=5

# NO se configura TELEFONIA_SOCKET_PATH: se deriva de DATA_DIR, que es lo
# correcto tanto en nativo como dentro del contenedor. Fijarlo a mano reproduce
# la trampa de rutas que ya costó una sesión con DATA_DIR.

# =============================================================================
# Llamada por navegador (WebRTC) — la interfaz que usa el jurado (G4)
# =============================================================================

# Servidores ICE, separados por comas. El STUN de Google basta en LAN; con el
# jurado en otra red hace falta un TURN (el túnel de Cloudflare transporta la
# señalización HTTP, pero no la media UDP de WebRTC).
# ICE_SERVERS=stun:stun.l.google.com:19302

# Credenciales del TURN, si ICE_SERVERS incluye uno (urls turn:/turns:).
# TURN_USERNAME=
# TURN_CREDENTIAL=
