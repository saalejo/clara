  <dc:title>
   <rdf:Alt>
    <rdf:li xml:lang='x-default'>Brief report: ``I can&amp;#x2019;t talk about it:&apos;&apos; sexuality and self-silencing as interactive predictors of depressive symptoms in adolescent dating couples</rdf:li>
   </rdf:Alt>
  </dc:title>
  <dc:creator>
   <rdf:Seq>
    <rdf:li>Katherine C. Little; Deborah P. Welsh; Nancy Darling; Rachel M. Holmes</rdf:li>
   </rdf:Seq>
  </dc:creator>
